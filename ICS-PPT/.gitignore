__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store
build/
*.egg-info/
node_modules/
package-lock.json
package.json
.superpowers/
.claude/settings.local.json
.claude/worktrees/

# What a `p.demo(...)` leaves behind. The compile demos in lectures/1-intro
# build in place, on purpose -- the point of the page is that you can look at
# the .i, the .s and the .o afterwards -- so the products are ignored and the
# sources beside them are not.
lectures/*/examples/*.i
lectures/*/examples/*.s
lectures/*/examples/*.o
lectures/*/examples/mini_ollama
lectures/*/examples/cpp_demo

# lectures/2-data/examples: every .c beside a demo compiles to a bare binary
# with the same name. The sources and tiny.gguf are kept; the binaries are not.
lectures/2-data/examples/bf16
lectures/2-data/examples/bitset_demo
lectures/2-data/examples/bool_c
lectures/2-data/examples/bool_cc
lectures/2-data/examples/compare
lectures/2-data/examples/float_law
lectures/2-data/examples/fp16_range
lectures/2-data/examples/gguf_head
lectures/2-data/examples/int4
lectures/2-data/examples/quantize
lectures/2-data/examples/rounding
lectures/2-data/examples/show_bytes
lectures/2-data/examples/sizes
lectures/2-data/examples/truncate

# lectures/3-*/examples (the five sections of lecture 3): same rule -- every
# source beside a demo compiles to a bare binary with the same name. .cu files
# build with nvcc, .sh builds the per-ISA objects that isa_width.sh counts.
# Hand-written assembly sources are kept despite the *.s rule above.
!lectures/3-1-registers/examples/modrm.s
!lectures/3-1-registers/examples/twomem.s
!lectures/3-3-control/examples/callconv.s
!lectures/3-5-simd/examples/linear_asm.s
lectures/3-*/examples/bigstack
lectures/3-1-registers/examples/linear.bin
lectures/3-*/examples/callconv
lectures/3-*/examples/divergence
lectures/3-*/examples/divmul
lectures/3-*/examples/echo_nopro
lectures/3-*/examples/echo_pro
lectures/3-*/examples/fround
lectures/3-*/examples/gpu_reduce
lectures/3-*/examples/linear_bench
lectures/3-*/examples/linear_cuda
lectures/3-*/examples/movsz
lectures/3-*/examples/structs
lectures/3-*/examples/hugearray
lectures/3-*/examples/vnni
lectures/3-*/examples/width-*

# lectures/4-cpu/examples: same rule again. linear.o is not covered by the
# *.o line above only because that line is what produces it, so it is listed
# here for the reader's sake.
lectures/4-cpu/examples/accum
lectures/4-cpu/examples/branch
lectures/4-cpu/examples/cycles
lectures/4-cpu/examples/depth
lectures/4-cpu/examples/linear_cpi
lectures/4-cpu/examples/ooo

# lectures/5-linking/examples: same rule again, plus the archives and shared
# objects the linking demos build. The .o files here are the subject of the
# lecture rather than a by-product, but they are reproducible from the .c
# beside them, so the *.o line above still covers them.
lectures/5-linking/examples/maps
lectures/5-linking/examples/prog
lectures/5-linking/examples/prog-static
lectures/5-linking/examples/layer2.c
lectures/5-linking/examples/dyn/dispatch
lectures/5-linking/examples/ggml/score
lectures/5-linking/examples/lib/infer
lectures/5-linking/examples/preload/work
lectures/5-linking/examples/so/infer
lectures/5-linking/examples/so/infer-lazy
lectures/5-linking/examples/weak/scale
lectures/*/examples/*.a
lectures/*/examples/*/*.a
lectures/*/examples/*/*.so
lectures/*/examples/*/*.o
